[sub_resource type="GDScript" id="GDScript_mte56"]
script/source = "extends SimpleComponent

@export var material : Material
@export var flash_speed : float = 0.08

var active := false
var flash_counter : float = 0

func _process(delta: float) -> void:
	if active:
		flash_counter -= delta
		if flash_counter > 0:
			apply_material_to_subtree(parent, null)
		else:
			apply_material_to_subtree(parent, material)
		
		if flash_counter < -flash_speed:
			flash_counter = flash_speed

func on_invincible_start():
	active = true
	flash_counter = flash_speed

func on_invincible_end():
	active = false
	apply_material_to_subtree(parent, null)

func apply_material_to_subtree(node: Node, mat: Material) -> void:
	if node is MeshInstance3D:
		node.material_overlay = mat

	for child in node.get_children():
		apply_material_to_subtree(child, mat)
"

