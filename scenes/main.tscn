[sub_resource type="GDScript" id="GDScript_v3a5a"]
script/source = "extends Node3D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Singleton.set_lives(3)
	LevelObjects.Tim = %Tim
	LevelObjects.Knife = %Knife
	LevelObjects.LevelManager = %LevelManager
	LevelObjects.CameraManager = $CameraManager
	LevelObjects.ScoreManager = $ScoreManager
	LevelObjects.PlayerSubtree = %PlayerSubtree
	LevelObjects.EnemySubtree = %EnemySubtree
	LevelObjects.BulletSubtree = %BulletSubtree
	LevelObjects.PickupSubtree = %PickupSubtree
	LevelObjects.DeathPanel = $CanvasLayer/UI/DeathPanel
	LevelObjects.WinPanel = $CanvasLayer/UI/WinPanel

func do_restart():
	get_tree().change_scene_to_file(\"res://scenes/main.tscn\")
"

