[sub_resource type="GDScript" id="GDScript_h3avq"]
script/source = "extends Node3D

@export var clouds : Array[PackedScene]
@export var spawn_rate : float = 1.1 # per sec

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	for i in range(18, -30, -3):
		spawn_cloud(i)


var timer : float = 0

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	timer -= delta
	if timer < 0:
		timer = spawn_rate
		spawn_cloud(-28)

func spawn_cloud(z: float):
	var i = randi_range(0, clouds.size()-1)
	var cloud = clouds[i].instantiate() as Sprite3D
	cloud.rotate(Vector3.UP, randf() * 100)
	var y = randf_range(-3, -20)
	cloud.position = Vector3(randf_range(-30, 30), y, z + y)
	add_child(cloud)
"

[sub_resource type="GDScript" id="GDScript_bdcc4"]
script/source = "extends Area3D

func _on_body_entered(body: Node3D) -> void:
	if body is not Enemy:
		print(\"non-enemy entered arena area...?\")
	body.propagate_call(\"on_arena_enter\")

func _on_body_exited(body: Node3D) -> void:
	if body is not Enemy:
		print(\"non-enemy exited arena area...?\")
	body.propagate_call(\"on_arena_exit\")
"

